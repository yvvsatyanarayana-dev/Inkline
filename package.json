{
  "name": "inkline",
  "version": "1.0.0",
  "description": "A polished desktop drawing app for sketching, notes, and exporting visuals.",
  "license": "MIT",
  "author": "Inkline Team",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "pack": "electron-packager . Inkline --platform=win32 --arch=x64 --icon=appicon.ico --overwrite",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.inkline.desktop",
    "productName": "Inkline",
    "icon": "appicon.ico",
    "files": [
      "main.js",
      "preload.js",
      "excalidraw-clone.html",
      "package.json",
      "appicon.ico",
      "appicon.png"
    ],
    "win": {
      "icon": "appicon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    }
  },
  "dependencies": {
    "buffer-crc32": "^0.2.13",
    "debug": "^4.4.3",
    "end-of-stream": "^1.4.5",
    "env-paths": "^3.0.0",
    "extract-zip": "^2.0.1",
    "fd-slicer": "^1.1.0",
    "get-stream": "^5.2.0",
    "graceful-fs": "^4.2.11",
    "ms": "^2.1.3",
    "once": "^1.4.0",
    "pend": "^1.2.0",
    "progress": "^2.0.3",
    "pump": "^3.0.4",
    "semver": "^7.8.0",
    "sumchecker": "^3.0.1",
    "undici": "^7.25.0",
    "undici-types": "^7.16.0",
    "wrappy": "^1.0.2",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2"
  }
}
